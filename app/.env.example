# NEXT_PUBLIC_DEMO_VIDEO_URL=https://example.com/demo.mp4

# Server-side RPC & SQLite indexer (optional; defaults to NEXT_PUBLIC_SOLANA_RPC / ../data/veritas.db)
# SOLANA_RPC=https://api.devnet.solana.com
# VERITAS_DB_PATH=../data/veritas.db
# VERITAS_DISABLE_ON_DEMAND_SYNC=0

# Faucet origin allowlist & real-wallet USDT faucet (/api/faucet)
# FAUCET_ALLOWED_ORIGINS=https://your-domain.example
# FAUCET_KEYPAIR_PATH=/path/to/faucet-keypair.json
# FAUCET_RPC_URL=https://api.devnet.solana.com
# FAUCET_STATE_PATH=/tmp/veritas-faucet.json
# FAUCET_IP_DAILY_LIMIT=5
# FAUCET_DAILY_CAP=200

# Zero-wallet Sandbox Account faucet (/api/faucet/sandbox)
# SANDBOX_FAUCET_KEYPAIR_PATH=/path/to/sandbox-faucet-keypair.json
# SANDBOX_FAUCET_RPC_URL=https://api.devnet.solana.com
# SANDBOX_FAUCET_COLLATERAL_MINT=CtiAxpKmXtK2bupa59GN6GPYXQiPPYUfSqnY1pgMD7QG
# SANDBOX_FAUCET_SOL_AMOUNT=0.04
# SANDBOX_FAUCET_USDT_AMOUNT=30
# SANDBOX_FAUCET_IP_DAILY_LIMIT=5
# SANDBOX_FAUCET_ADDRESS_DAILY_LIMIT=5
# SANDBOX_FAUCET_DAILY_CLAIM_CAP=100
# SANDBOX_FAUCET_DAILY_SOL_CAP=2
# SANDBOX_FAUCET_LOCK_MS=10000
# SANDBOX_ACTIVE_FILE=/tmp/veritas-sandbox-active.json

# Test flags (optional)
# VERITAS_DEVNET_ACCEPTANCE=0
